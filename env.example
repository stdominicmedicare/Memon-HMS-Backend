# Backend Environment Variables
# Copy to .env and fill in values

PORT=5000
NODE_ENV=development

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# API
API_BASE_URL=http://localhost:5000
# CORS: single line, comma-separated origins (no spaces). Include every URL the frontend runs on.
# Required when frontend uses credentials: 'include'. Use https if frontend uses Vite with mkcert.
FRONTEND_URL=https://localhost:5173,http://localhost:5173
